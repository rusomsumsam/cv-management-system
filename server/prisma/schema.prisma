generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  email        String  @unique
  password     String?
  profilePhoto String?
  location     String?
  role         Role    @default(CANDIDATE)
  isBlocked    Boolean @default(false)

  projects                 Project[]
  positions                Position[]
  userAttributes           UserAttribute[]
  cvs                      CV[]
  discussions              Discussion[]
  likes                    Like[]
  oauthAccounts            OAuthAccount[]
  createdPositionApiTokens PositionApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  title       String
  description String?

  startDate DateTime?
  endDate   DateTime?
  isOngoing Boolean   @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectTags ProjectTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startDate])
}

model Tag {
  id String @id @default(cuid())

  name           String
  normalizedName String @unique

  projectTags  ProjectTag[]
  positionTags PositionTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model PositionTag {
  id String @id @default(cuid())

  positionId String
  tagId      String

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([positionId, tagId])
  @@index([positionId])
  @@index([tagId])
}

model ProjectTag {
  id String @id @default(cuid())

  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, tagId])
  @@index([projectId])
  @@index([tagId])
}

enum AttributeType {
  STRING
  TEXT
  IMAGE
  NUMERIC
  DATE
  PERIOD
  BOOLEAN
  DROPDOWN
}

enum PositionAccessType {
  PUBLIC
  RESTRICTED
}

enum AccessRuleLogic {
  ALL
  ANY
}

enum AccessRuleOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BEFORE
  ON_OR_BEFORE
  AFTER
  ON_OR_AFTER
  IS_TRUE
  IS_FALSE
}

model Attribute {
  id String @id @default(cuid())

  name String @unique

  category String

  type AttributeType

  userAttributes      UserAttribute[]
  positionAttributes  PositionAttribute[]
  positionAccessRules PositionAccessRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id String @id @default(cuid())

  title       String
  description String?

  company    String?
  location   String?
  department String?
  deadline   DateTime?

  isActive        Boolean            @default(true)
  accessType      PositionAccessType @default(PUBLIC)
  accessRuleLogic AccessRuleLogic    @default(ALL)

  maxProjects Int @default(4)
  version     Int @default(1)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  positionAttributes PositionAttribute[]
  accessRules        PositionAccessRule[]
  positionTags       PositionTag[]
  cvs                CV[]
  discussions        Discussion[]
  apiToken           PositionApiToken?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PositionApiToken {
  id String @id @default(cuid())

  tokenHash String @unique

  positionId String   @unique
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model UserAttribute {
  id String @id @default(cuid())

  userId      String
  attributeId String

  value   String?
  version Int     @default(1)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, attributeId])
}

model PositionAttribute {
  id String @id @default(cuid())

  positionId  String
  attributeId String

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([positionId, attributeId])
}

model PositionAccessRule {
  id String @id @default(cuid())

  positionId  String
  attributeId String

  operator AccessRuleOperator

  value String?

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([positionId, attributeId])
  @@index([positionId])
  @@index([attributeId])
}

enum CVStatus {
  DRAFT
  PUBLISHED
}

model CV {
  id String @id @default(cuid())

  fullName String
  email    String
  phone    String?

  summary    String?
  skills     String?
  education  String?
  experience String?
  projects   String?

  status CVStatus @default(DRAFT)

  userId     String
  positionId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  likes Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, positionId])
}

model Discussion {
  id String @id @default(cuid())

  content String

  userId     String
  positionId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id String @id @default(cuid())

  userId String
  cvId   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv   CV   @relation(fields: [cvId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, cvId])
}
